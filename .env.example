# Tina CMS Configuration
# Get these values from https://tina.io after creating your account and connecting your repo

# Tina Client ID (from tina.io dashboard)
VITE_TINA_CLIENT_ID=your_client_id_here

# Tina Read-Only Token (from tina.io dashboard)
VITE_TINA_TOKEN=your_token_here

# Note: Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and should never be committed
