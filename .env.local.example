# Copy this file to .env.local (gitignored) for local development.

# SHA-256 hash of the password that unlocks /writing/admin.
# Generate one in a browser console or Node with:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('your-password')).then(b => console.log(Buffer.from(b).toString('hex')))"
# In production, set this as a GitHub Actions repo secret named VITE_ADMIN_PASSWORD_HASH
# (Settings -> Secrets and variables -> Actions) instead of committing it here.
VITE_ADMIN_PASSWORD_HASH=

# Posts API URL (optional - defaults to https://posts-api.stefanosugbit.workers.dev)
# For local development with a local worker, set to http://localhost:8787
VITE_POSTS_API_URL=
